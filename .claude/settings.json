{
  "permissions": {
    "allow": [
      "Bash(mkdir -p services)",
      "Bash(git submodule *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx block-no-verify"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx block-no-verify"
          }
        ]
      }
    ]
  }
}
